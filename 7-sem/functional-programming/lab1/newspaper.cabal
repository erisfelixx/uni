cabal-version:      3.0
name:               newspaper
version:            0.1.0.0
synopsis:           Information system "Faculty online newspaper" (Haskell + MySQL)
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

executable newspaper
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    other-modules:    Db
                      Console
                      Classes
                      Repository
                      Models
                      Stats
    build-depends:    base >=4 && <5
                    , mysql-simple >=0.4 && <0.5
                    , text
                    , time
    default-language: GHC2021